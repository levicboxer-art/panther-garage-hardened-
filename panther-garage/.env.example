# Copy to .env.local. Get these from Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
# Server-only. Never expose this variable to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Primary AI assistant and alert-digest provider. Server-only; never prefix with NEXT_PUBLIC_.
HUGGINGFACE_API_KEY=hf_your_inference_providers_token
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
HUGGINGFACE_MODEL=Qwen/Qwen3.8-27B
# Optional legacy fallback if no Hugging Face token is configured.
# DEEPSEEK_API_KEY=YOUR_API_KEY
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash
# Boss notification email digest (server-only, Resend-compatible REST API).
# Leave unset to keep in-app notifications without email delivery.
RESEND_API_KEY=YOUR_RESEND_API_KEY
NOTIFICATION_EMAIL_FROM=Panther Garage <alerts@your-domain.example>
BOSS_ALERT_EMAIL=boss@your-domain.example
