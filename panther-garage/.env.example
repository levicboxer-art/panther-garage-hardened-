# Copy to .env.local. Get these from Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
# Server-only. Never expose this variable to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000
# AI assistant (OpenAI-compatible provider: DeepSeek direct or OpenRouter). Server-only; the browser never sees this key.
DEEPSEEK_API_KEY=YOUR_API_KEY
# Current setup uses OpenRouter:
#   DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
#   DEEPSEEK_MODEL=deepseek/deepseek-v4.1-flash-1017
# Defaults without overrides: DEEPSEEK_MODEL=deepseek-flash, DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional Ollama Cloud provider. If set and DEEPSEEK_API_KEY is absent, the assistant uses Ollama.
OLLAMA_API_KEY=YOUR_OLLAMA_API_KEY
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gpt-oss:20b
# Boss notification email digest (server-only, Resend-compatible REST API).
# Leave unset to keep in-app notifications without email delivery.
RESEND_API_KEY=YOUR_RESEND_API_KEY
NOTIFICATION_EMAIL_FROM=Panther Garage <alerts@your-domain.example>
BOSS_ALERT_EMAIL=boss@your-domain.example
